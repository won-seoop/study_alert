#!/usr/bin/env bash
set -euo pipefail

LABEL_PREFIX="com.wonhyeonseob.routinealert"
PLIST_DIR="$HOME/Library/LaunchAgents"
STATE_DIR="$HOME/.routine_alert"

usage() {
  cat <<'EOF'
Usage:
  bin/routine-alert on
  bin/routine-alert off
  bin/routine-alert status

Routine alerts:
  07:00 기상
  07:10 코테 1문제
  07:50 코테 1문제
  08:00 데일리 스크럼
  08:20 데일리 스크럼
  08:20 기업 정하기
  09:50 기업 정하기
  10:00 이력서 작성
  10:50 이력서 작성
  11:00 포트폴리오 작성
  11:50 포트폴리오 작성
  13:00 프로젝트 성능개선 - Habruta(~5/10) / BookPick(~~5월) / OurUniverse(~~6월)
  15:50 프로젝트 성능개선 - Habruta(~5/10) / BookPick(~~5월) / OurUniverse(~~6월)
  17:00 해커톤 / 오픈소스 / 방향성 점검 / 회고(루틴점검) (3일 주기 운영)
  17:50 해커톤 / 오픈소스 / 방향성 점검 / 회고(루틴점검) (3일 주기 운영)
  19:00 CS 학습
  19:50 CS 학습
  20:00 못한 작업 하기
  20:50 못한 작업 하기
  21:00 운동
  22:00 운동
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || die "this script is macOS-only"
}

label_for_alert() {
  local hour="$1"
  local minute="$2"
  local key="$3"
  printf '%s.h%02dm%02d.%s' "$LABEL_PREFIX" "$hour" "$minute" "$key"
}

plist_for_alert() {
  local hour="$1"
  local minute="$2"
  local key="$3"
  printf '%s/%s.plist' "$PLIST_DIR" "$(label_for_alert "$hour" "$minute" "$key")"
}

notify_script_for_alert() {
  local hour="$1"
  local minute="$2"
  local key="$3"
  printf '%s/notify-h%02dm%02d-%s.sh' "$STATE_DIR" "$hour" "$minute" "$key"
}

bootout_if_loaded() {
  local plist="$1"
  [[ -f "$plist" ]] || return 0
  launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
}

write_notify_script() {
  local path="$1"
  local message="$2"

  mkdir -p "$STATE_DIR"
  cat > "$path" <<EOF
#!/usr/bin/env bash
set -euo pipefail

ALERT_MESSAGE=$(printf '%q' "$message")

/usr/bin/osascript - "\$ALERT_MESSAGE" <<'APPLESCRIPT'
on run argv
  display dialog (item 1 of argv) with title "Routine Alert" buttons {"OK"} default button "OK" giving up after 20
end run
APPLESCRIPT
EOF
  chmod +x "$path"
}

write_plist() {
  local plist="$1"
  local label="$2"
  local notify_script="$3"
  local hour="$4"
  local minute="$5"

  mkdir -p "$PLIST_DIR"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>

  <key>ProgramArguments</key>
  <array>
    <string>$notify_script</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$hour</integer>
    <key>Minute</key>
    <integer>$minute</integer>
  </dict>
</dict>
</plist>
EOF
}

register_alert() {
  local hour="$1"
  local minute="$2"
  local key="$3"
  local message="$4"
  local label
  local plist
  local notify_script

  label="$(label_for_alert "$hour" "$minute" "$key")"
  plist="$(plist_for_alert "$hour" "$minute" "$key")"
  notify_script="$(notify_script_for_alert "$hour" "$minute" "$key")"

  write_notify_script "$notify_script" "$message"
  bootout_if_loaded "$plist"
  write_plist "$plist" "$label" "$notify_script" "$hour" "$minute"
  launchctl bootstrap "gui/$(id -u)" "$plist"
  launchctl enable "gui/$(id -u)/$label"

  printf 'ON: %02d:%02d %s\n' "$hour" "$minute" "$message"
}

cmd_on() {
  require_macos

  register_alert 7 0 wake "기상"
  register_alert 7 10 coding-test-start "코테 1문제"
  register_alert 7 50 coding-test-end "코테 1문제"
  register_alert 8 0 scrum-start "데일리 스크럼"
  register_alert 8 20 scrum-end "데일리 스크럼"
  register_alert 8 20 company-start "기업 정하기"
  register_alert 9 50 company-end "기업 정하기"
  register_alert 10 0 resume-start "이력서 작성"
  register_alert 10 50 resume-end "이력서 작성"
  register_alert 11 0 portfolio-start "포트폴리오 작성"
  register_alert 11 50 portfolio-end "포트폴리오 작성"
  register_alert 13 0 performance-start "프로젝트 성능개선 - Habruta(~5/10) / BookPick(~~5월) / OurUniverse(~~6월)"
  register_alert 15 50 performance-end "프로젝트 성능개선 - Habruta(~5/10) / BookPick(~~5월) / OurUniverse(~~6월)"
  register_alert 17 0 direction-start "해커톤 / 오픈소스 / 방향성 점검 / 회고(루틴점검) (3일 주기 운영)"
  register_alert 17 50 direction-end "해커톤 / 오픈소스 / 방향성 점검 / 회고(루틴점검) (3일 주기 운영)"
  register_alert 19 0 cs-start "CS 학습"
  register_alert 19 50 cs-end "CS 학습"
  register_alert 20 0 catchup-start "못한 작업 하기"
  register_alert 20 50 catchup-end "못한 작업 하기"
  register_alert 21 0 workout-start "운동"
  register_alert 22 0 workout-end "운동"
}

cmd_off() {
  require_macos

  local plist
  for plist in "$PLIST_DIR/$LABEL_PREFIX".*.plist; do
    [[ -e "$plist" ]] || continue
    bootout_if_loaded "$plist"
    rm -f "$plist"
  done
  rm -rf "$STATE_DIR"
  echo "OFF: routine alert 알림을 모두 해제했습니다."
}

cmd_status() {
  require_macos

  local found=0
  local plist
  local label
  for plist in "$PLIST_DIR/$LABEL_PREFIX".*.plist; do
    [[ -e "$plist" ]] || continue
    found=1
    label="$(basename "$plist" .plist)"
    echo "ON: $plist"
    launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 \
      && echo "loaded: yes" \
      || echo "loaded: no"
  done

  if [[ "$found" -eq 0 ]]; then
    echo "OFF: 등록된 routine alert plist가 없습니다."
  fi
}

main() {
  [[ $# -eq 1 ]] || { usage; exit 1; }

  case "$1" in
    on)
      cmd_on
      ;;
    off)
      cmd_off
      ;;
    status)
      cmd_status
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
