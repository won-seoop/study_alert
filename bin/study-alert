#!/usr/bin/env bash
set -euo pipefail

LABEL_PREFIX="com.wonhyeonseob.studyalert"
PLIST_DIR="$HOME/Library/LaunchAgents"
STATE_DIR="$HOME/.study_alert"
LABEL=""
PLIST=""
NOTIFY_SCRIPT=""

usage() {
  cat <<'EOF'
Usage:
  bin/study-alert on <start_hour> <end_hour> <minute> [message]
  bin/study-alert off
  bin/study-alert status

Examples:
  bin/study-alert on 8 15 50   # 08:50, 09:50, ... 15:50 every day
  bin/study-alert on 8 15 0 "[{minute}] 공부시간입니다. 화이팅"
  bin/study-alert on 8 15 50 "[{minute}] 쉬는시간입니다. 고생하셨어요."
  bin/study-alert off          # remove all study alerts

Notes:
  - macOS only.
  - Popup alerts are created through launchd.
  - The popup closes automatically after 20 seconds.
  - Use {minute} in the message to insert the current minute.
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || die "this script is macOS-only"
}

validate_number() {
  local name="$1"
  local value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be a number"
}

set_paths_for_minute() {
  local minute="$1"
  LABEL="$LABEL_PREFIX.m$(printf '%02d' "$minute")"
  PLIST="$PLIST_DIR/$LABEL.plist"
  NOTIFY_SCRIPT="$STATE_DIR/notify-m$(printf '%02d' "$minute").sh"
}

bootout_if_loaded() {
  local plist="$1"
  [[ -f "$plist" ]] || return 0
  launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
}

write_notify_script() {
  local message="$1"

  mkdir -p "$STATE_DIR"
  cat > "$NOTIFY_SCRIPT" <<EOF
#!/usr/bin/env bash
set -euo pipefail

ALERT_MESSAGE=$(printf '%q' "$message")

minute="\$(date '+%M')"
message="\${ALERT_MESSAGE//\\{minute\\}/\$minute}"

/usr/bin/osascript - "\$message" <<'APPLESCRIPT'
on run argv
  display dialog (item 1 of argv) with title "Study Alert" buttons {"OK"} default button "OK" giving up after 20
end run
APPLESCRIPT
EOF
  chmod +x "$NOTIFY_SCRIPT"
}

write_plist() {
  local start_hour="$1"
  local end_hour="$2"
  local minute="$3"

  mkdir -p "$(dirname "$PLIST")"

  {
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>

  <key>ProgramArguments</key>
  <array>
    <string>$NOTIFY_SCRIPT</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
EOF

    local hour
    for ((hour = start_hour; hour <= end_hour; hour++)); do
      cat <<EOF
    <dict>
      <key>Hour</key>
      <integer>$hour</integer>
      <key>Minute</key>
      <integer>$minute</integer>
    </dict>
EOF
    done

    cat <<'EOF'
  </array>
</dict>
</plist>
EOF
  } > "$PLIST"
}

cmd_on() {
  [[ $# -ge 3 ]] || { usage; exit 1; }

  local start_hour="$1"
  local end_hour="$2"
  local minute="$3"
  shift 3
  local message
  if [[ $# -gt 0 ]]; then
    message="$*"
  else
    message="[{minute}] 쉬는시간입니다. 고생하셨어요."
  fi

  validate_number "start_hour" "$start_hour"
  validate_number "end_hour" "$end_hour"
  validate_number "minute" "$minute"

  (( start_hour >= 0 && start_hour <= 23 )) || die "start_hour must be 0-23"
  (( end_hour >= 0 && end_hour <= 23 )) || die "end_hour must be 0-23"
  (( start_hour <= end_hour )) || die "start_hour must be less than or equal to end_hour"
  (( minute >= 0 && minute <= 59 )) || die "minute must be 0-59"

  require_macos
  set_paths_for_minute "$minute"
  write_notify_script "$message"
  bootout_if_loaded "$PLIST"
  write_plist "$start_hour" "$end_hour" "$minute"
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  launchctl enable "gui/$(id -u)/$LABEL"

  printf 'ON: %02d:%02d부터 %02d:%02d까지 매일 %02d분 알림을 등록했습니다.\n' \
    "$start_hour" "$minute" "$end_hour" "$minute" "$minute"
  echo "message: $message"
  echo "plist: $PLIST"
}

cmd_off() {
  require_macos
  local plist
  for plist in "$PLIST_DIR/$LABEL_PREFIX".plist "$PLIST_DIR/$LABEL_PREFIX".*.plist; do
    [[ -e "$plist" ]] || continue
    bootout_if_loaded "$plist"
    rm -f "$plist"
  done
  rm -f "$STATE_DIR"/notify.sh "$STATE_DIR"/notify-m*.sh
  echo "OFF: study alert 알림을 모두 해제했습니다."
}

cmd_status() {
  require_macos
  local found=0
  local plist
  local label
  for plist in "$PLIST_DIR/$LABEL_PREFIX".plist "$PLIST_DIR/$LABEL_PREFIX".*.plist; do
    [[ -e "$plist" ]] || continue
    found=1
    label="$(basename "$plist" .plist)"
    echo "ON: $plist"
    launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 \
      && echo "loaded: yes" \
      || echo "loaded: no"
  done

  if [[ "$found" -eq 0 ]]; then
    echo "OFF: 등록된 study alert plist가 없습니다."
  fi
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 1; }

  case "$1" in
    on)
      shift
      cmd_on "$@"
      ;;
    off)
      shift
      [[ $# -eq 0 ]] || { usage; exit 1; }
      cmd_off
      ;;
    status)
      shift
      [[ $# -eq 0 ]] || { usage; exit 1; }
      cmd_status
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
